<?xml version="1.0" encoding="utf-8"?>
<!-- Indicador de selección de la lista de coleccionistas: cian con check o vidrio con punto. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/vn_secondary" />
                </shape>
            </item>
            <item android:bottom="6dp" android:drawable="@drawable/ic_check_dark" android:left="6dp" android:right="6dp" android:top="6dp" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/vn_glass_strong" />
                </shape>
            </item>
            <item android:bottom="12dp" android:left="12dp" android:right="12dp" android:top="12dp">
                <shape android:shape="oval">
                    <solid android:color="@color/vn_on_surface_subtle" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
