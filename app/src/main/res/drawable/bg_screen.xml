<?xml version="1.0" encoding="utf-8"?>
<!-- Capa 0: lienzo medianoche con orbes de color difusos (violeta, cian y magenta). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vn_background" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.15"
                android:centerY="0.05"
                android:endColor="@color/vn_transparent"
                android:gradientRadius="70%p"
                android:startColor="@color/vn_orb_violet"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1.0"
                android:centerY="0.55"
                android:endColor="@color/vn_transparent"
                android:gradientRadius="60%p"
                android:startColor="@color/vn_orb_cyan"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.0"
                android:centerY="1.0"
                android:endColor="@color/vn_transparent"
                android:gradientRadius="60%p"
                android:startColor="@color/vn_orb_magenta"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
