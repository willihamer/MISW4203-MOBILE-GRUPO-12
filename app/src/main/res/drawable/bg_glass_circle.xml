<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/vn_glass_strong" />
            <stroke android:width="@dimen/vn_border" android:color="@color/vn_secondary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/vn_glass" />
            <stroke android:width="@dimen/vn_border" android:color="@color/vn_glass_border" />
        </shape>
    </item>
</selector>
