<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta destacada: vidrio con tinte violeta a cian y borde iluminado. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vn_radius_card" />
            <gradient
                android:angle="0"
                android:endColor="#4022D3EE"
                android:startColor="#737C3AED" />
            <stroke android:width="@dimen/vn_border" android:color="@color/vn_secondary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vn_radius_card" />
            <gradient
                android:angle="0"
                android:endColor="#2622D3EE"
                android:startColor="#4D7C3AED" />
            <stroke android:width="@dimen/vn_border" android:color="@color/vn_glass_highlight" />
        </shape>
    </item>
</selector>
