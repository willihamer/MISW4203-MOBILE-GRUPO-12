<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vn_radius_pill" />
            <solid android:color="@color/vn_glass_strong" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/vn_radius_pill" />
            <gradient
                android:angle="0"
                android:endColor="#FF1BB8D0"
                android:startColor="#FF6A2BD6" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_gradient_primary" />
</selector>
