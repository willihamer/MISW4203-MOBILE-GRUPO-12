<?xml version="1.0" encoding="utf-8"?>
<!-- P08 Crear álbum (HU07): formulario completo en modo coleccionista. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Encabezado: flecha atrás, título "Nuevo álbum" y chip de perfil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vn_screen_margin"
        android:paddingTop="@dimen/vn_space_md"
        android:paddingEnd="@dimen/vn_screen_margin"
        android:paddingBottom="@dimen/vn_space_sm">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Widget.Vinilos.IconButton"
            android:contentDescription="@string/artist_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vn_space_md"
            android:layout_marginEnd="@dimen/vn_space_sm"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/album_create_title"
            android:textAppearance="@style/TextAppearance.Vinilos.HeadlineLarge"
            tools:targetApi="28" />

        <include
            android:id="@+id/profile_chip"
            layout="@layout/view_profile_chip" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/form_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/vn_screen_margin"
        android:paddingTop="@dimen/vn_space_sm"
        android:paddingEnd="@dimen/vn_screen_margin"
        android:paddingBottom="@dimen/vn_space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tarjeta de vista previa en vivo -->
            <LinearLayout
                android:id="@+id/preview_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card_highlight"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/vn_space_md">

                <FrameLayout
                    android:layout_width="112dp"
                    android:layout_height="96dp">

                    <ImageView
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center_vertical|end"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_vinyl" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/preview_cover"
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:layout_gravity="center_vertical|start"
                        android:background="@drawable/bg_cover"
                        android:contentDescription="@string/album_create_preview_cover_label"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Vinilos.Cover" />

                    <LinearLayout
                        android:id="@+id/preview_cover_placeholder"
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:layout_gravity="center_vertical|start"
                        android:gravity="center"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical"
                        android:padding="@dimen/vn_space_xs"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_album"
                            app:tint="@color/vn_primary_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/album_create_preview_cover_label"
                            android:textAppearance="@style/TextAppearance.Vinilos.Caption"
                            android:textColor="@color/vn_on_surface_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/vn_space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/preview_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/album_create_preview_title_placeholder"
                        android:textAppearance="@style/TextAppearance.Vinilos.HeadlineMedium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/vn_space_sm"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/preview_genre"
                            style="@style/Widget.Vinilos.Badge"
                            android:text="@string/album_create_preview_genre_placeholder"
                            tools:text="Salsa" />

                        <TextView
                            android:id="@+id/preview_record_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/vn_space_sm"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
                            tools:text="· Elektra" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Campo 1: Nombre del álbum -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/album_create_name_label"
                    android:textAppearance="@style/TextAppearance.Vinilos.LabelLarge" />

                <TextView
                    android:id="@+id/name_required_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/album_create_required_badge"
                    android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                    android:textColor="@color/vn_error"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <EditText
                android:id="@+id/name_input"
                style="@style/Widget.Vinilos.TextField"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/vn_space_sm"
                android:autofillHints=""
                android:hint="@string/album_create_name_hint"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences" />

            <TextView
                android:id="@+id/name_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                android:textColor="@color/vn_error"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_error_outline"
                tools:text="@string/album_create_error_required"
                tools:visibility="visible" />

            <!-- Campo 2: URL de la portada -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/album_create_cover_label"
                    android:textAppearance="@style/TextAppearance.Vinilos.LabelLarge" />

                <TextView
                    android:id="@+id/cover_required_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/album_create_required_badge"
                    android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                    android:textColor="@color/vn_error"
                    android:visibility="gone" />
            </LinearLayout>

            <EditText
                android:id="@+id/cover_input"
                style="@style/Widget.Vinilos.TextField"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/vn_space_sm"
                android:autofillHints=""
                android:drawableEnd="@drawable/ic_image"
                android:hint="@string/album_create_cover_hint"
                android:imeOptions="actionDone"
                android:inputType="textUri" />

            <TextView
                android:id="@+id/cover_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                android:textColor="@color/vn_error"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_error_outline" />

            <!-- Campo 3: Fecha de lanzamiento -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/album_create_release_date_label"
                    android:textAppearance="@style/TextAppearance.Vinilos.LabelLarge" />

                <TextView
                    android:id="@+id/release_date_required_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/album_create_required_badge"
                    android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                    android:textColor="@color/vn_error"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/release_date_input"
                style="@style/Widget.Vinilos.TextField"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/vn_space_sm"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:hint="@string/album_create_release_date_hint"
                app:drawableEndCompat="@drawable/ic_calendar"
                app:drawableTint="@color/vn_secondary" />

            <TextView
                android:id="@+id/release_date_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                android:textColor="@color/vn_error"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_error_outline" />

            <!-- Campo 4: Género -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/album_create_genre_label"
                    android:textAppearance="@style/TextAppearance.Vinilos.LabelLarge" />

                <TextView
                    android:id="@+id/genre_required_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/album_create_required_badge"
                    android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                    android:textColor="@color/vn_error"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/genre_input"
                style="@style/Widget.Vinilos.TextField"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/vn_space_sm"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:hint="@string/album_create_genre_hint"
                app:drawableEndCompat="@drawable/ic_expand_more"
                app:drawableTint="@color/vn_secondary" />

            <TextView
                android:id="@+id/genre_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                android:textColor="@color/vn_error"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_error_outline" />

            <!-- Campo 5: Sello discográfico -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/album_create_record_label_label"
                    android:textAppearance="@style/TextAppearance.Vinilos.LabelLarge" />

                <TextView
                    android:id="@+id/record_label_required_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/album_create_required_badge"
                    android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                    android:textColor="@color/vn_error"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/record_label_input"
                style="@style/Widget.Vinilos.TextField"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/vn_space_sm"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:hint="@string/album_create_record_label_hint"
                app:drawableEndCompat="@drawable/ic_expand_more"
                app:drawableTint="@color/vn_secondary" />

            <TextView
                android:id="@+id/record_label_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                android:textColor="@color/vn_error"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_error_outline" />

            <!-- Campo 6: Descripción del álbum -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/album_create_description_label"
                    android:textAppearance="@style/TextAppearance.Vinilos.LabelLarge" />

                <TextView
                    android:id="@+id/description_required_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/album_create_required_badge"
                    android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                    android:textColor="@color/vn_error"
                    android:visibility="gone" />
            </LinearLayout>

            <EditText
                android:id="@+id/description_input"
                style="@style/Widget.Vinilos.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_sm"
                android:autofillHints=""
                android:gravity="top|start"
                android:hint="@string/album_create_description_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="6"
                android:minHeight="108dp"
                android:minLines="3"
                android:paddingTop="@dimen/vn_space_md"
                android:paddingBottom="@dimen/vn_space_md"
                android:singleLine="false" />

            <TextView
                android:id="@+id/description_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                android:textColor="@color/vn_error"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_error_outline" />

            <!-- Error de red / servidor al enviar -->
            <TextView
                android:id="@+id/submit_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_md"
                android:background="@drawable/bg_input_error"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:padding="@dimen/vn_space_md"
                android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
                android:textColor="@color/vn_error"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_error_outline" />

            <!-- Botones de acción 50% / 50%: Cancelar (vidrio) a la izquierda, Guardar (gradiente) a la derecha -->
            <!-- baselineAligned="false": si "Guardar álbum" ocupa dos líneas (pantallas de 360 dp),
                 alinear por la línea base bajaba el botón y lo recortaba; además ahorra una medición -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_lg"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancel_button"
                    style="@style/Widget.Vinilos.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/vn_space_sm"
                    android:layout_weight="1"
                    android:text="@string/album_create_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/save_button"
                    style="@style/Widget.Vinilos.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/vn_space_sm"
                    android:layout_weight="1"
                    android:text="@string/album_create_save" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
