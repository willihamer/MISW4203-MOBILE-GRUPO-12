<?xml version="1.0" encoding="utf-8"?>
<!-- P05 Detalle de músico y P05b Detalle de banda (HU04). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/vn_space_xl">

            <!-- Hero: foto del artista que se funde con el lienzo -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/vn_artist_hero_height">

                <ImageView
                    android:id="@+id/hero_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/ic_artist_placeholder_musician" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_artist_hero_scrim" />
            </FrameLayout>

            <!-- Tipo, fecha, nombre y descripción, superpuestos al final del hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_artist_hero_overlap"
                android:orientation="vertical"
                android:paddingStart="@dimen/vn_screen_margin"
                android:paddingEnd="@dimen/vn_screen_margin">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/type_badge"
                        style="@style/Widget.Vinilos.Badge"
                        tools:text="Músico" />

                    <TextView
                        android:id="@+id/date_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/vn_space_sm"
                        android:background="@drawable/bg_glass_pill"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                        app:drawableStartCompat="@drawable/ic_calendar"
                        tools:text="Nacimiento: 16/07/1948" />
                </LinearLayout>

                <TextView
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.Vinilos.DisplayLarge"
                    tools:text="Rubén Blades" />

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.Vinilos.BodyLarge"
                    tools:text="Cantante, compositor y actor panameño." />
            </LinearLayout>

            <!-- Integrantes: solo para bandas -->
            <LinearLayout
                android:id="@+id/members_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_xl"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/members_title"
                    style="@style/Widget.Vinilos.SectionTitle"
                    android:text="@string/artist_members_title"
                    app:drawableStartCompat="@drawable/ic_people" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/member_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vn_space_sm"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="2"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_band_member" />

                <TextView
                    android:id="@+id/members_empty"
                    style="@style/Widget.Vinilos.SectionEmpty"
                    android:text="@string/artist_members_empty"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Álbumes del artista -->
            <TextView
                android:id="@+id/albums_title"
                style="@style/Widget.Vinilos.SectionTitle"
                android:layout_marginTop="@dimen/vn_space_xl"
                android:text="@string/artist_albums_title"
                app:drawableStartCompat="@drawable/ic_album" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/album_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_sm"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_artist_album" />

            <TextView
                android:id="@+id/albums_empty"
                style="@style/Widget.Vinilos.SectionEmpty"
                android:text="@string/artist_albums_empty"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Cargando y error, debajo de la barra superior -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/vn_artist_top_bar_height">

        <include
            android:id="@+id/loading"
            layout="@layout/view_artist_detail_loading"
            android:visibility="gone" />

        <include
            android:id="@+id/error"
            layout="@layout/view_state_error"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Barra superior fija: volver y chip de perfil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vn_artist_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vn_screen_margin"
        android:paddingEnd="@dimen/vn_screen_margin">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Widget.Vinilos.IconButton"
            android:contentDescription="@string/artist_back"
            android:src="@drawable/ic_arrow_back" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/profile_chip"
            layout="@layout/view_profile_chip" />
    </LinearLayout>
</FrameLayout>
