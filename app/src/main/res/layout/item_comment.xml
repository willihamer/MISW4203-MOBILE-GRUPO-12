<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="8dp" android:orientation="vertical"
    android:background="@drawable/bg_glass_card" android:padding="16dp">
    <TextView android:id="@+id/comment_score" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.Vinilos.LabelLarge"
        android:textColor="@color/vn_accent_warm" />
    <TextView android:id="@+id/comment_description" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Vinilos.BodyLarge" />
</LinearLayout>
