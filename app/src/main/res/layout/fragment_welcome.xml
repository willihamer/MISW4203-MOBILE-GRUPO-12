<?xml version="1.0" encoding="utf-8"?>
<!-- P01 Bienvenida: el usuario entra como visitante o como coleccionista. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/vn_screen_margin"
        android:paddingTop="@dimen/vn_space_xl"
        android:paddingEnd="@dimen/vn_screen_margin"
        android:paddingBottom="@dimen/vn_space_lg">

        <ImageView
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:contentDescription="@string/cd_vinyl"
            android:src="@drawable/ic_vinyl" />

        <LinearLayout
            style="@style/Widget.Vinilos.Badge"
            android:layout_marginTop="@dimen/vn_space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="@dimen/vn_space_sm"
                android:background="@drawable/bg_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_badge"
                android:textAppearance="@style/TextAppearance.Vinilos.Overline" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_space_md"
            android:text="@string/welcome_title"
            android:textAppearance="@style/TextAppearance.Vinilos.DisplayLarge"
            android:textSize="40sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_space_sm"
            android:gravity="center"
            android:maxWidth="320dp"
            android:text="@string/welcome_subtitle"
            android:textAppearance="@style/TextAppearance.Vinilos.BodyLarge" />

        <!-- Opción visitante -->
        <LinearLayout
            android:id="@+id/option_visitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_space_xl"
            android:background="@drawable/bg_option_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="88dp"
            android:orientation="horizontal"
            android:padding="@dimen/vn_space_md">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_tile"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/ic_eye" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vn_space_md"
                android:layout_marginEnd="@dimen/vn_space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome_visitor_title"
                    android:textAppearance="@style/TextAppearance.Vinilos.TitleLarge" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/welcome_visitor_subtitle"
                    android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium" />
            </LinearLayout>

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_glass_circle"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <!-- Opción coleccionista -->
        <LinearLayout
            android:id="@+id/option_collector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_space_md"
            android:background="@drawable/bg_glass_card_highlight"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="88dp"
            android:orientation="horizontal"
            android:padding="@dimen/vn_space_md">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_icon_tile_primary"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/ic_album" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vn_space_md"
                android:layout_marginEnd="@dimen/vn_space_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/welcome_collector_title"
                        android:textAppearance="@style/TextAppearance.Vinilos.TitleLarge" />

                    <TextView
                        style="@style/Widget.Vinilos.Badge"
                        android:layout_marginStart="@dimen/vn_space_sm"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="@string/welcome_collector_badge" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/welcome_collector_subtitle"
                    android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium" />
            </LinearLayout>

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_glass_circle"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/vn_secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_space_lg"
            android:drawablePadding="@dimen/vn_space_sm"
            android:gravity="center"
            android:text="@string/welcome_footer"
            android:textAppearance="@style/TextAppearance.Vinilos.Caption"
            app:drawableStartCompat="@drawable/ic_sparkle" />
    </LinearLayout>
</ScrollView>
