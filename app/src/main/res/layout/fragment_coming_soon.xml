<?xml version="1.0" encoding="utf-8"?>
<!-- Pestañas cuyas HU llegan en el Sprint 2 (Artistas y Coleccionistas). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vn_screen_margin"
        android:layout_marginTop="@dimen/vn_space_md"
        android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.Vinilos.HeadlineLarge"
        android:textSize="28sp" />

    <include
        android:id="@+id/empty"
        layout="@layout/view_state_empty" />
</LinearLayout>
