<?xml version="1.0" encoding="utf-8"?>
<!-- P09 Agregar track (HU08): hoja inferior sobre el detalle del álbum, solo en modo coleccionista. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/vn_screen_margin"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/vn_screen_margin"
        android:paddingBottom="@dimen/vn_space_lg">

        <!-- Manija y botón de cerrar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="@dimen/vn_space_sm"
                android:background="@drawable/bg_sheet_handle" />

            <ImageButton
                android:id="@+id/close_button"
                style="@style/Widget.Vinilos.IconButton"
                android:layout_gravity="end"
                android:contentDescription="@string/cd_close"
                android:src="@drawable/ic_close" />
        </FrameLayout>

        <!-- Encabezado: • NUEVA ENTRADA, título y álbum de destino -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vn_space_sm"
                android:text="@string/track_add_overline"
                android:textAppearance="@style/TextAppearance.Vinilos.Overline" />
        </LinearLayout>

        <TextView
            android:id="@+id/sheet_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_space_xs"
            android:text="@string/track_add_title"
            android:textAppearance="@style/TextAppearance.Vinilos.HeadlineLarge" />

        <TextView
            android:id="@+id/album_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_space_xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
            android:textColor="@color/vn_on_surface_muted"
            tools:text="Buscando América • Rubén Blades" />

        <!-- Campo 1: nombre del track -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_space_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/track_add_name_label"
                android:textAppearance="@style/TextAppearance.Vinilos.LabelLarge" />

            <TextView
                android:id="@+id/track_name_required_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_add_required_badge"
                android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                android:textColor="@color/vn_primary_light" />
        </LinearLayout>

        <EditText
            android:id="@+id/track_name_input"
            style="@style/Widget.Vinilos.TextField"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/vn_space_sm"
            android:autofillHints=""
            android:drawablePadding="@dimen/vn_space_sm"
            android:hint="@string/track_add_name_hint"
            android:imeOptions="actionNext"
            android:inputType="textCapSentences"
            android:maxLines="1"
            app:drawableEndCompat="@drawable/ic_music_note"
            app:drawableTint="@color/vn_on_surface_subtle" />

        <TextView
            android:id="@+id/track_name_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
            android:textColor="@color/vn_error"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_error_outline"
            tools:text="@string/track_add_error_required"
            tools:visibility="visible" />

        <!-- Campo 2: duración mm:ss -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/track_add_duration_label"
                android:textAppearance="@style/TextAppearance.Vinilos.LabelLarge" />

            <TextView
                android:id="@+id/track_duration_required_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_add_required_badge"
                android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
                android:textColor="@color/vn_primary_light" />
        </LinearLayout>

        <EditText
            android:id="@+id/track_duration_input"
            style="@style/Widget.Vinilos.TextField"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/vn_space_sm"
            android:autofillHints=""
            android:digits="0123456789:"
            android:drawablePadding="@dimen/vn_space_sm"
            android:hint="@string/track_add_duration_hint"
            android:imeOptions="actionDone"
            android:inputType="time"
            android:maxLength="5"
            android:maxLines="1"
            app:drawableEndCompat="@drawable/ic_schedule"
            app:drawableTint="@color/vn_on_surface_subtle" />

        <TextView
            android:id="@+id/track_duration_helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:text="@string/track_add_duration_helper"
            android:textAppearance="@style/TextAppearance.Vinilos.Caption"
            android:textColor="@color/vn_on_surface_subtle"
            app:drawableStartCompat="@drawable/ic_info_outline"
            app:drawableTint="@color/vn_on_surface_subtle" />

        <TextView
            android:id="@+id/track_duration_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
            android:textColor="@color/vn_error"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_error_outline"
            tools:text="@string/track_add_error_duration_format" />

        <!-- Error de red o del servidor al guardar -->
        <TextView
            android:id="@+id/submit_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_space_md"
            android:background="@drawable/bg_input_error"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:padding="@dimen/vn_space_md"
            android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
            android:textColor="@color/vn_error"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_error_outline" />

        <!-- Acciones 50 % / 50 %: Cancelar y Agregar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vn_space_lg"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                style="@style/Widget.Vinilos.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/vn_space_sm"
                android:layout_weight="1"
                android:text="@string/track_add_cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_track_button"
                style="@style/Widget.Vinilos.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vn_space_sm"
                android:layout_weight="1"
                android:text="@string/track_add_save"
                app:icon="@drawable/ic_add_circle_outline"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
