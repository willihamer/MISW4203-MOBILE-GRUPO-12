<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="@dimen/vn_screen_margin">
    <ImageButton android:id="@+id/back_button" style="@style/Widget.Vinilos.IconButton"
        android:src="@drawable/ic_arrow_back" android:contentDescription="@string/artist_back" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.core.widget.NestedScrollView android:id="@+id/content"
            android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingTop="@dimen/vn_space_lg">
                <TextView android:id="@+id/avatar" android:layout_width="88dp" android:layout_height="88dp"
                    android:gravity="center" android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.Vinilos.HeadlineLarge" />
                <TextView android:id="@+id/collector_name" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/vn_space_lg"
                    android:textAppearance="@style/TextAppearance.Vinilos.HeadlineLarge" />
                <TextView android:id="@+id/collector_email" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/vn_space_sm"
                    android:textAppearance="@style/TextAppearance.Vinilos.BodyLarge" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:contentDescription="@string/collectors_loading" />
        <include android:id="@+id/error" layout="@layout/view_state_error" android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
