<?xml version="1.0" encoding="utf-8"?>
<!-- P07 Detalle de coleccionista (HU06). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/vn_artist_top_bar_height"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/vn_space_xl">

            <!-- Encabezado: avatar con iniciales, nombre y datos de contacto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/vn_screen_margin"
                android:paddingEnd="@dimen/vn_screen_margin">

                <FrameLayout
                    android:layout_width="@dimen/vn_collector_avatar_size"
                    android:layout_height="@dimen/vn_collector_avatar_size"
                    android:background="@drawable/bg_avatar_ring"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/avatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="@style/TextAppearance.Vinilos.HeadlineLarge"
                        tools:text="MB" />
                </FrameLayout>

                <TextView
                    android:id="@+id/collector_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vn_space_md"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Vinilos.HeadlineLarge"
                    tools:text="Manolo Bellon" />

                <TextView
                    android:id="@+id/collector_phone"
                    style="@style/Widget.Vinilos.ContactPill"
                    android:layout_marginTop="@dimen/vn_space_md"
                    app:drawableStartCompat="@drawable/ic_phone"
                    tools:text="3502457896" />

                <TextView
                    android:id="@+id/collector_email"
                    style="@style/Widget.Vinilos.ContactPill"
                    android:layout_marginTop="@dimen/vn_space_sm"
                    app:drawableStartCompat="@drawable/ic_mail"
                    tools:text="manollo@caracol.com.co" />
            </LinearLayout>

            <!-- Artistas favoritos -->
            <TextView
                style="@style/Widget.Vinilos.SectionTitle"
                android:layout_marginTop="@dimen/vn_space_xl"
                android:text="@string/collector_favorites_title"
                app:drawableStartCompat="@drawable/ic_mic" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favorite_artist_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_sm"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_favorite_performer" />

            <TextView
                android:id="@+id/favorites_empty"
                style="@style/Widget.Vinilos.SectionEmpty"
                android:text="@string/collector_favorites_empty"
                android:visibility="gone" />

            <!-- Álbumes de su colección -->
            <TextView
                style="@style/Widget.Vinilos.SectionTitle"
                android:layout_marginTop="@dimen/vn_space_xl"
                android:text="@string/collector_albums_title"
                app:drawableStartCompat="@drawable/ic_album" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/collection_album_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_sm"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_collector_album" />

            <TextView
                android:id="@+id/collection_empty"
                style="@style/Widget.Vinilos.SectionEmpty"
                android:text="@string/collector_albums_empty"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Cargando y error, debajo de la barra superior -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/vn_artist_top_bar_height">

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/collector_loading"
            android:visibility="gone" />

        <include
            android:id="@+id/error"
            layout="@layout/view_state_error"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Barra superior fija: volver y chip de perfil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/vn_artist_top_bar_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/vn_screen_margin"
        android:paddingEnd="@dimen/vn_screen_margin">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/Widget.Vinilos.IconButton"
            android:contentDescription="@string/artist_back"
            android:src="@drawable/ic_arrow_back" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/profile_chip"
            layout="@layout/view_profile_chip" />
    </LinearLayout>
</FrameLayout>
