<?xml version="1.0" encoding="utf-8"?>
<!-- P12 Agregar músico (HU12): hoja sobre el detalle de la banda, solo en modo coleccionista. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/vn_screen_margin"
    android:paddingTop="12dp"
    android:paddingEnd="@dimen/vn_screen_margin"
    android:paddingBottom="@dimen/vn_space_lg">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Título, banda de destino y botón de cerrar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vn_space_md"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheet_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/band_member_add"
                android:textAppearance="@style/TextAppearance.Vinilos.HeadlineLarge" />

            <TextView
                android:id="@+id/band_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_xs"
                android:textAppearance="@style/TextAppearance.Vinilos.TitleMedium"
                android:textColor="@color/vn_secondary"
                tools:text="Queen" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/close_button"
            style="@style/Widget.Vinilos.IconButton"
            android:contentDescription="@string/cd_close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <EditText
        android:id="@+id/search_field"
        style="@style/Widget.Vinilos.TextField"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/vn_space_lg"
        android:autofillHints=""
        android:drawablePadding="@dimen/vn_space_sm"
        android:hint="@string/band_member_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="textCapWords"
        android:maxLines="1"
        app:drawableStartCompat="@drawable/ic_search"
        app:drawableTint="@color/vn_on_surface_subtle" />

    <!-- Lista, carga, mensaje (vacío, sin resultados o error) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vn_space_md"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/musician_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="4"
            tools:listitem="@layout/item_musician_option" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@string/band_member_loading"
            android:indeterminateTint="@color/vn_secondary" />

        <LinearLayout
            android:id="@+id/message_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.Vinilos.BodyLarge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_button"
                style="@style/Widget.Vinilos.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vn_space_md"
                android:text="@string/retry"
                app:icon="@drawable/ic_refresh" />
        </LinearLayout>
    </FrameLayout>

    <!-- Error de red o del servidor al guardar -->
    <TextView
        android:id="@+id/submit_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vn_space_md"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_input_error"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:padding="@dimen/vn_space_md"
        android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
        android:textColor="@color/vn_error"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_error_outline" />

    <!-- Acciones 50 % / 50 %: Cancelar y Agregar a la banda -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vn_space_md"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_button"
            style="@style/Widget.Vinilos.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/vn_space_sm"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="@string/action_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_members_button"
            style="@style/Widget.Vinilos.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vn_space_sm"
            android:layout_weight="1"
            android:enabled="false"
            android:maxLines="2"
            android:text="@string/band_member_submit"
            app:icon="@drawable/ic_done_all"
            app:iconGravity="textEnd" />
    </LinearLayout>
</LinearLayout>
