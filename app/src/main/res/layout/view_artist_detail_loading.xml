<?xml version="1.0" encoding="utf-8"?>
<!-- Estado cargando del detalle de artista (HU04). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingBottom="@dimen/vn_artist_top_bar_height">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/vn_secondary"
        app:trackColor="@color/vn_glass" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vn_space_md"
        android:text="@string/artist_loading"
        android:textAppearance="@style/TextAppearance.Vinilos.BodyLarge" />
</LinearLayout>
