<?xml version="1.0" encoding="utf-8"?>
<!-- Escala tipográfica: Sora para títulos, Inter para cuerpo y datos. Tamaños en sp. -->
<resources>
    <style name="TextAppearance.Vinilos.DisplayLarge" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/sora_bold</item>
        <item name="fontFamily">@font/sora_bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/vn_on_surface</item>
    </style>

    <style name="TextAppearance.Vinilos.HeadlineLarge" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/sora_bold</item>
        <item name="fontFamily">@font/sora_bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.015</item>
        <item name="android:textColor">@color/vn_on_surface</item>
    </style>

    <style name="TextAppearance.Vinilos.HeadlineMedium" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/sora_bold</item>
        <item name="fontFamily">@font/sora_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/vn_on_surface</item>
    </style>

    <style name="TextAppearance.Vinilos.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="fontFamily">@font/sora_semibold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/vn_on_surface</item>
    </style>

    <style name="TextAppearance.Vinilos.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/vn_on_surface</item>
    </style>

    <style name="TextAppearance.Vinilos.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/vn_on_surface_muted</item>
    </style>

    <style name="TextAppearance.Vinilos.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/vn_on_surface_muted</item>
    </style>

    <style name="TextAppearance.Vinilos.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textColor">@color/vn_on_surface</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Vinilos.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">@color/vn_on_surface_muted</item>
    </style>

    <style name="TextAppearance.Vinilos.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/vn_secondary</item>
    </style>

    <style name="TextAppearance.Vinilos.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/vn_on_surface_subtle</item>
    </style>
</resources>
